{
  "name": "angular-learning-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler pages deploy dist",
    "preview": "npm run build && wrangler pages dev dist",
    "postinstall": "fumadocs-mdx",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test --workers=1",
    "check:diagrams": "node scripts/audit-diagrams.mjs",
    "prebuild": "npm run check:diagrams"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fuma-translate/react": "^1.0.2",
    "@fumadocs/base-ui": "16.17.5",
    "@vanhiep99w/docs-kit": "0.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "lucide-react": "^1.44.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "scroll-into-view-if-needed": "^3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "wrangler": "^4.75.0"
  },
  "engines": {
    "node": ">=22"
  }
}
